# ============================================
# Deep 大肥鱼 · 学生生活管理台 环境变量模板
# 复制本文件为 .env.local（本地）或在 Render 控制台配置
# ============================================

# ---------- Supabase（必填）----------
# Supabase 项目地址（Project Settings → API → Project URL）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase 匿名公钥（Project Settings → API → anon public key）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Supabase 服务端密钥（Project Settings → API → service_role key，保密！）
# 用于：注册时免邮箱验证直接创建用户、定时提醒跨用户查询
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- DeepSeek AI（必填）----------
# DeepSeek API 密钥（https://platform.deepseek.com → API Keys）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 接口地址（可选，默认 https://api.deepseek.com）
# LLM_API_BASE_URL=https://api.deepseek.com
# 文本模型（可选，默认 deepseek-chat）
# LLM_MODEL=deepseek-chat
# 视觉模型（可选，默认同 LLM_MODEL；用于通知截图 OCR 识别）
# LLM_VISION_MODEL=deepseek-chat

# ---------- QQ 邮箱提醒（可选，不配置则跳过邮件发送）----------
# 发件 QQ 邮箱地址
EMAIL_USER=123456789@qq.com
# QQ 邮箱 SMTP 授权码（QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码）
EMAIL_PASS=xxxxxxxxxxxxxxxx
# 收件邮箱（可选，默认同 EMAIL_USER）
# NOTIFY_EMAIL=123456789@qq.com

# ---------- 定时提醒鉴权（可选）----------
# 外部定时服务（如 cron-job.org）调用 /api/reminders/check 时携带
# CRON_SECRET=your-random-secret
